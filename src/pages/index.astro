---
import BaseLayout from "../layouts/BaseLayout.astro";
import Github from "simple-icons-astro/Github";
import Anilist from "simple-icons-astro/Anilist";
import Lastdotfm from "simple-icons-astro/Lastdotfm";
import Link from "../components/Link.astro";
---

<BaseLayout>
  <div class="flex flex-col text-center items-center gap-y-4">
    <p>I'm Callum Wong, a student from Sydney, Australia. 🇭🇰🇦🇺</p>
    <p>
      Check out my <Link href="/posts">posts</Link>, see some of my
      <Link href="https://gallery.callumwong.com">photos</Link>, or read more
      <Link href="/about">about me</Link>.
    </p>
    <p>
      Projects:
      <span class="inline-flex flex-wrap gap-x-2 justify-center">
        <Link href="https://github.com/L9-bms/JishinTray">JishinTray</Link>
        <Link href="https://github.com/L9-bms/ChronomiaWatchFace">
          Chronomia Watch Face
        </Link>
      </span>
    </p>
    <div class="flex flex-row gap-x-4 my-2">
      <a href="https://github.com/L9-bms"><Github /></a>
      <a href="https://anilist.co/user/dondokodokodoko"><Anilist /></a>
      <a href="https://www.last.fm/user/a65_7a"><Lastdotfm /></a>
    </div>
    <p>Thank you for visiting!</p>
  </div>
</BaseLayout>
