---
import BaseLayout from "../layouts/BaseLayout.astro";
import Link from "../components/Link.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");
---

<BaseLayout>
  <div class="max-w-prose">
    <div class="flex flex-col gap-y-2">
      <p>I'm Callum Wong, a student from Sydney, Australia. 🇭🇰🇦🇺</p>
      <p>
        <span class="inline-flex flex-wrap gap-x-2 justify-center">
          Projects:
          <Link href="/posts/discord-llm-scraper">Discord LLM Scraper</Link>
          <Link href="https://github.com/L9-bms/JishinTray">JishinTray</Link>
          <Link href="https://github.com/L9-bms/ChronomiaWatchFace">
            Chronomia Watch Face
          </Link>
        </span>
      </p>
    </div>
    <div class="pt-8">
      <h2 class="font-bold text-2xl mb-6">Recent</h2>
      {
        posts
          .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
          .map((post) => (
            <div class="mb-3">
              <span>{post.data.date.toISOString().substring(0, 10)}</span>
              <Link href={`/posts/${post.id}`}>{post.data.title}</Link>
            </div>
          ))
      }
    </div>
  </div>
</BaseLayout>
